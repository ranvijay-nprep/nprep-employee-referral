# Where this app's own SQLite database lives. On Railway, point this at a
# path inside a mounted Volume so it survives restarts/deploys - Railway's
# default filesystem is NOT persistent, same as Vercel.
SQLITE_DB_PATH=./data/referral.sqlite

# Google Cloud OAuth client (console.cloud.google.com -> APIs & Services ->
# Credentials -> OAuth client ID -> Web application). Authorized redirect URI
# must be <your-domain>/auth/callback (and http://localhost:3000/auth/callback
# for local dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Restrict Google sign-in to this email domain (no leading @). Both vars must
# match - the NEXT_PUBLIC_ one only hints Google's account picker UI; the
# server one is the actual enforcement in src/app/auth/callback/route.ts.
ALLOWED_EMAIL_DOMAIN=nprep.in
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=nprep.in

# Who receives "new coupon request" emails (comma-separated for multiple admins)
ADMIN_NOTIFY_EMAILS=admin@nprep.in

# Bootstrap admin(s): these emails get role='admin' the first time they sign
# in. Promote further admins later by editing the employees table directly.
ADMIN_EMAILS=admin@nprep.in

# Resend (resend.com) - transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Navigator <navigator@nprep.in>

# NPrep production DB - READ-ONLY credentials only. Never grant this user
# INSERT/UPDATE/DELETE. This app must never write to NPrep's database.
NPREP_DB_HOST=
NPREP_DB_PORT=3306
NPREP_DB_USER=
NPREP_DB_PASSWORD=
NPREP_DB_NAME=

# Shared secret for manually/externally triggering the coupon-activation
# check over HTTP (Authorization: Bearer <this>). The real schedule runs
# in-process (src/instrumentation.ts) - this is just a debug/manual escape
# hatch, not required for normal operation.
CRON_SECRET=
